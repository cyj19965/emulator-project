{
  "manifest_version": 3,
  "name": "사과게임 풀이기",
  "version": "1.6.0",
  "description": "사과게임(Fruit Box) 화면을 캡처해 숫자를 인식하고, 높은 점수가 나오는 드래그 순서를 별도 창에 보여줍니다.",
  "permissions": [
    "scripting",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "사과게임 풀이기 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.gamesaien.com/*",
        "http://www.gamesaien.com/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}